{
  "_meta": {
    "title": "OCMP offline fail-closed vectors",
    "profile": "CLCV1/OCMP v0 (offline-capability-manifest-profile-v0.md)",
    "status": "reference only",
    "date": "2026-09-11",
    "note": "Word-of-agreement class set for OCMP R2-R7 (all 11 §3 reason codes). These cases are NOT part of CLC-A/B authorization semantics (OCMP §8); they are fail-closed reference inputs for offline evaluation. Every entry is checked against the OCMP rules (NAM §3): missing/bad input -> deny, never raise."
  },
  "vectors": [
    {
      "id": "offline-001",
      "ocmp_class": "trust_anchor_missing",
      "ocmp_level": "OCMP-1",
      "rule": "R2",
      "scenario": "Principal/agent chain does not chain to a configured trust anchor",
      "inputs": {
        "grant_covers": true,
        "trust_anchor": false,
        "local_policy": true,
        "status": {
          "present": true,
          "verified": true,
          "as_of": 1000,
          "valid_until": 3000,
          "version": 5,
          "last_accepted": 5
        },
        "credential_expired": false,
        "revoked": false,
        "replay_enabled": true,
        "counter": 8,
        "last_consumed": 7,
        "required_fact": true,
        "fact_available": true,
        "trusted_time": 2000,
        "clock_offset": 0,
        "clock_tolerance": 300
      },
      "expect": {
        "verdict": "deny",
        "reason": "trust_anchor_missing"
      },
      "derivation": "input marked MUST in OCMP §2 is unreadable -> deny (R2)",
      "description": {
        "trust_anchor": null,
        "credential": "present, self-issued"
      }
    },
